{
  "name": "dockly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "db:migrate": "node server/db/migrate.mjs",
    "db:migrate:status": "node server/db/migrate.mjs --status",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:db:stop": "node scripts/dev-setup.mjs --stop"
  },
  "devDependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.56",
    "pg": "^8.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@fontsource/heebo": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "lucide-react": "^0.577.0",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
