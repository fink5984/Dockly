# ── Required ─────────────────────────────────────────────
# Postgres connection string (Supabase → Project settings → Database → connection string).
# The server is the only component that connects to the database.
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres
# Long random secret for session cookies and signed file URLs (>= 32 chars).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Public URL of the app (used in links sent to clients).
APP_BASE_URL=https://your-app.example.com

# ── Storage (AWS S3, private bucket) ─────────────────────
AWS_S3_BUCKET=dockly-documents
AWS_S3_REGION=il-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: STORAGE_DRIVER=local stores files on disk under LOCAL_STORAGE_DIR (dev only)
# MAX_UPLOAD_MB=25

# ── WhatsApp Cloud API (official Meta API) ───────────────
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta → App settings → Basic. Required to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Approved template names
WA_TEMPLATE_DOCUMENT_REQUEST=
WA_TEMPLATE_DOCUMENT_REMINDER=
WA_TEMPLATE_DOCUMENT_REJECTED=
WA_TEMPLATE_STAFF_REPLY=
# Optional template for signing invitations: {{1}} name, {{2}} title, {{3}} link
WA_TEMPLATE_SIGNATURE_REQUEST=
WA_TEMPLATE_LANG=he
# WHATSAPP_MODE=log   # record messages without sending (dev/test)

# ── Email (optional, Resend) ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Sadir <no-reply@your-domain.com>

# ── Automation ───────────────────────────────────────────
# AUTOMATION_ENABLED=true
# AUTOMATION_INTERVAL_MS=300000

# ── Public website ───────────────────────────────────────
# Shown on the privacy policy, terms and accessibility statement. Set before launch.
SITE_LEGAL_NAME=Sadir Ltd.
SITE_CONTACT_EMAIL=support@your-domain.com

# ── Billing & payments (Cardcom) ─────────────────────────
# Without Cardcom credentials, production runs with billing "disabled":
# trials work, paid checkout shows "contact us". Development uses a labelled sandbox.
# BILLING_PROVIDER=cardcom            # cardcom | sandbox | disabled (auto-detected)
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
# Needed for transaction listing (daily reconciliation) and refunds.
CARDCOM_API_PASSWORD=
# Cardcom issues the tax invoice/receipt for every charge (requires the documents module on the terminal).
# CARDCOM_ISSUE_DOCUMENTS=true
# CARDCOM_DOCUMENT_TYPE=TaxInvoiceAndReceipt
# 32+ random characters. Encrypts stored payment tokens. Never change it without re-tokenizing cards.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BILLING_ENCRYPTION_KEY=
# Shown when online payment is unavailable.
BILLING_SALES_EMAIL=
# BILLING_TICK_INTERVAL_MS=600000     # renewals, trial expiry, dunning, reconciliation
# BILLING_SANDBOX_IN_PRODUCTION=true  # staging only — never on the real site
