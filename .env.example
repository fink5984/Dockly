# ── Required ─────────────────────────────────────────────
# Postgres connection string (Supabase → Project settings → Database → connection string).
# The server is the only component that connects to the database.
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres
# Long random secret for session cookies and signed file URLs (>= 32 chars).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Public URL of the app (used in links sent to clients).
APP_BASE_URL=https://your-app.example.com

# ── Storage (AWS S3, private bucket) ─────────────────────
AWS_S3_BUCKET=dockly-documents
AWS_S3_REGION=il-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: STORAGE_DRIVER=local stores files on disk under LOCAL_STORAGE_DIR (dev only)
# MAX_UPLOAD_MB=25

# ── WhatsApp Cloud API (official Meta API) ───────────────
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta → App settings → Basic. Required to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Approved template names
WA_TEMPLATE_DOCUMENT_REQUEST=
WA_TEMPLATE_DOCUMENT_REMINDER=
WA_TEMPLATE_DOCUMENT_REJECTED=
WA_TEMPLATE_STAFF_REPLY=
# Optional template for signing invitations: {{1}} name, {{2}} title, {{3}} link
WA_TEMPLATE_SIGNATURE_REQUEST=
WA_TEMPLATE_LANG=he
# WHATSAPP_MODE=log   # record messages without sending (dev/test)

# ── Email (optional, Resend) ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Dockly <no-reply@your-domain.com>

# ── Automation ───────────────────────────────────────────
# AUTOMATION_ENABLED=true
# AUTOMATION_INTERVAL_MS=300000
